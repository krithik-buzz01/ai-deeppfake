{
  "name": "verifai",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -n \"AI,BACKEND,FRONTEND\" -c \"magenta,blue,cyan\" \"npm run dev:ai\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "dev:backend": "tsx watch backend/src/server.ts",
    "dev:ai": "python -m uvicorn app.main:app --app-dir ai-service --host 0.0.0.0 --port 8000 --reload",
    "dev:worker": "tsx watch workers/src/index.ts",
    "build:frontend": "vite build --config frontend/vite.config.ts",
    "build": "vite build --config frontend/vite.config.ts",
    "test": "vitest run tests/backend/backend.test.ts && vitest run tests/frontend/frontend.test.tsx",
    "test:backend": "vitest run tests/backend/backend.test.ts",
    "test:frontend": "vitest run tests/frontend/frontend.test.tsx",
    "test:ai": "$env:PYTHONPATH=\"ai-service\"; python -m pytest tests/ai-service/test_ai_service.py -v"
  },
  "dependencies": {
    "@node-rs/argon2": "^2.2.2",
    "@tanstack/react-query": "^5.105.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/nodemailer": "^8.0.2",
    "@types/pdfkit": "^0.17.7",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "bcryptjs": "^3.0.3",
    "bullmq": "^6.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "framer-motion": "^14.7.1",
    "ioredis": "^6.0.0",
    "jsonwebtoken": "^9.0.3",
    "lucide-react": "^1.48.0",
    "mongoose": "^9.10.3",
    "multer": "^2.4.0",
    "nodemailer": "^10.2.1",
    "pdfkit": "^0.20.2",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "supertest": "^7.3.1",
    "swagger-ui-express": "^5.0.1",
    "twilio": "^6.2.0",
    "vitest": "^5.0.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vite": "^8.3.5"
  }
}
